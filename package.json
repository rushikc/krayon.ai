{
  "name": "krayon",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n fe,be,reel,studio -c blue,green,magenta,yellow \"pnpm frontend\" \"pnpm backend\" \"pnpm reel-backend\" \"pnpm studio-backend\"",
    "dev:all": "pnpm dev",
    "frontend": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "backend": "bash src/backend/bash.sh",
    "reel-backend": "pnpm --filter @krayon/reel-backend dev",
    "studio-backend": "pnpm --filter @krayon/studio-backend dev",
    "krayon": "pnpm --filter @krayon/studio-backend krayon",
    "lint": "pnpm --filter @krayon/reel-backend lint && pnpm --filter @krayon/studio-backend lint",
    "typecheck": "tsc --noEmit && pnpm --filter @krayon/reel-backend typecheck && pnpm --filter @krayon/studio-backend typecheck",
    "test": "vitest run && pnpm --filter @krayon/reel-backend test && pnpm --filter @krayon/studio-backend test",
    "test:watch": "vitest",
    "test:backend": "bash src/backend/test.sh",
    "test:reel": "pnpm --filter @krayon/reel-backend test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.30.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.1",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}

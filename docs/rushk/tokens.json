{
  "name": "rushk",
  "version": "0.1.0",
  "notes": [
    "Colours were sampled from frames of the Airbnb and Uber reference reels (approximate, quantised to 8-bit steps).",
    "Layout percentages were measured on the Uber reel (1512x2688) and the Airbnb reel (1080x1920).",
    "Font families for VN text are not identified yet and are marked to-confirm.",
    "Timings come from a video-analysis pass and are approximate."
  ],
  "frame": {
    "aspect": "9:16",
    "referenceSizes": ["1080x1920", "1512x2688"],
    "background": "#000000",
    "grid": { "style": "faint thin grey perspective grid", "opacity": "low (to sample)" },
    "camera": "static"
  },
  "color": {
    "background": "#000000",
    "card": "#FFFFFF",
    "titleWhite": "#FFFFFF",
    "titleGreen": "#18C058",
    "badgeBlue": "#0860F0",
    "badgeText": "#FFFFFF",
    "strokeBlue": "#1860B8",
    "annotationRed": "#D82828",
    "success": "#18C058",
    "ink": "#000000"
  },
  "colorRoles": {
    "blue": "structure, main actors, badges",
    "black": "neutral machinery, arrows in Airbnb",
    "red": "data, inputs, limits, warnings, failure X",
    "green": "results, approval, checks, titles on results slides"
  },
  "layout": {
    "titleBand": { "topPct": 8, "bottomPct": 15, "align": "center", "lines": 2 },
    "card": { "leftPct": 8, "rightPct": 92, "widthPct": [82, 84], "topPctRange": [13, 17], "bottomPctRange": [75, 83], "align": "center" },
    "captionUnderCard": { "gapPct": 1, "align": "left-or-center", "prefix": "> " },
    "bottomSafeZone": "keep empty"
  },
  "card": {
    "fill": "#FFFFFF",
    "source": "Excalidraw export with background, cropped tight",
    "cornerRadiusPx1080": [0, 8],
    "padding": "whatever the export gives"
  },
  "diagram": {
    "source": "Excalidraw website, default hand-drawn style",
    "strokeWidth": "thin",
    "node": { "shape": "rounded-rectangle", "fill": "#FFFFFF", "stroke": "#000000" },
    "keyNode": { "stroke": "#1860B8" },
    "arrow": { "head": "open V", "stroke": ["#000000", "#1860B8"] },
    "annotation": { "font": "Excalidraw hand font", "color": "#D82828" },
    "maxShapesPerCard": 6
  },
  "text": {
    "source": "VN editor text styles (font names to confirm)",
    "title": { "font": "bold clean sans (to confirm)", "colors": ["#FFFFFF", "#18C058"], "lines": 2, "align": "center" },
    "caption": { "font": "bold sans (to confirm)", "color": "#FFFFFF", "prefix": "> " },
    "resultBullet": { "font": "bold sans (to confirm)", "color": "#FFFFFF", "prefix": "> ", "afterNarration": "green check" },
    "badge": { "fill": "#0860F0", "color": "#FFFFFF", "cornerRadiusPx1080": [4, 5], "border": "none", "lines": [1, 2] },
    "nameCard": { "name": "Rushi", "role": "Senior SDE @Warner Bros", "outroLine": "Hey, I'm Rushi. If you liked it, do save it and follow me for more tech content." }
  },
  "animation": {
    "entry": "hard pop (VN pop-in preset, inferred), no stroke drawing",
    "syncToVoice": "on the exact keyword",
    "secondsPerChange": [1.5, 2.5],
    "sectionSeconds": [10, 15],
    "transitions": { "airbnb": "slide left, about 0.3s", "uber": "hard cut to blank card" },
    "inPlaceChanges": ["label swap", "diamond to rectangle", "bullet to green check", "red X lands on node"],
    "camera": "none"
  },
  "audio": { "voice": "male voiceover", "music": "none", "sfx": "none", "captions": "none" },
  "length": { "shortSeconds": [45, 60], "longSeconds": [80, 95] }
}
